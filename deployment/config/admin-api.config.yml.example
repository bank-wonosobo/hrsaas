app:
  name: "Admin API HRIS"
  host: "0.0.0.0"
  port: 9000
  env: "production"
  cookie_secure: true
  cookie_domain: ""
  prefork: false

database:
  username: ""
  password: ""
  host: ""
  port: 5432
  name: "hr_saas"
  sslmode: "disable"
  timezone: "Asia/Jakarta"
  pool:
    idle: 10
    max: 100
    lifetime: 300

log:
  level: "info"
  format: "text"

s3:
  endpoint: "" # kosongkan untuk AWS, isi untuk MinIO/Cloudflare R2
  region: ""
  bucket: ""
  public_bucket: ""
  access_key: ""
  secret_key: ""
  public_url: ""
