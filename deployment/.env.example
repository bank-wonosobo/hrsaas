# Image tag to deploy: development | test | main | <git-sha>
TAG=development

# Host port overrides (optional)
ADMIN_API_PORT=9001
CLIENT_API_PORT=9002
ADMIN_PANEL_PORT=3000

# Cloudflare Tunnel tokens (from Cloudflare Zero Trust dashboard, one tunnel per service)
CF_ADMIN_API_TOKEN=
CF_CLIENT_API_TOKEN=
CF_ADMIN_PANEL_TOKEN=
