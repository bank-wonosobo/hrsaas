  "name": "akses-plus",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@config-plugins/react-native-blob-util": "^14.0.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/ui": "~57.0.8",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "expo": "~57.0.9",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-manipulator": "~57.0.7",
    "expo-linking": "~57.0.4",
    "expo-location": "~57.0.7",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.11",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.83.0",
    "react-native": "0.86.2",
    "react-native-blob-util": "^0.24.10",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^4.3.2",
    "uniwind": "^1.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "APP_ENV=development dotenv -e .env.development -- expo start",
    "start:staging": "EXPO_NO_DOTENV=1 APP_ENV=staging dotenv -e .env.staging -- expo start",
    "start:prod": "EXPO_NO_DOTENV=1 APP_ENV=production dotenv -e .env.production -- expo start",
    "android": "APP_ENV=development expo run:android",
    "ios": "APP_ENV=development expo run:ios",
    "web": "APP_ENV=development expo start --web",
    "lint": "expo lint",
    "reset-project": "node ./scripts/reset-project.js",
    "build:dev": "eas build --profile development",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:staging": "eas build --profile staging",
    "build:staging:android": "eas build --profile staging --platform android",
    "build:staging:ios": "eas build --profile staging --platform ios",
    "build:prod": "eas build --profile production",
    "build:prod:android": "eas build --profile production --platform android",
    "build:prod:ios": "eas build --profile production --platform ios",
    "build:prod:android:submit": "eas build --profile production --platform android --auto-submit",
    "build:prod:ios:submit": "eas build --profile production --platform ios --auto-submit",
    "build:prod:submit": "eas build --profile production --auto-submit",
    "build:staging:android:submit": "eas build --profile staging --platform android --auto-submit",
    "update:staging": "APP_ENV=staging eas update --channel staging",
    "update:prod": "APP_ENV=production eas update --channel production",
    "submit:prod": "eas submit --profile production",
    "submit:internal": "eas submit --profile internal"
  },
  "private": true
}
